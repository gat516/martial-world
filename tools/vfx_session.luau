	for _, l in { { "LShoulder", "LElbow" }, { "LElbow", "LHand" }, { "RShoulder", "RElbow" }, { "RElbow", "RHand" }, { "Neck", "Belly" } } do
		beam(lines, l[1] .. "_" .. l[2], l[1], l[2], bone, {
