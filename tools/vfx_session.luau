local installed = {}
do -- export_rbxm.luau
	local ok, msg = pcall(function()
--!nocheck
-- Full-fidelity export of an instance tree to a binary .rbxm (keeps every
-- property, attributes and tags, unlike export_rbxmx.luau). Use it for VFX, whose
-- plugin settings (EmitCount, EmitDelay, ...) live in attributes. Run this file
-- once through the Studio MCP's execute_luau: it installs
-- _G.exportRbxm(path, rootName?), which returns the file as base64. With
-- tools/receive_rbxmx.py running:
--   game:GetService("HttpService"):PostAsync("http://127.0.0.1:8766/Effects.rbxm",
--     _G.exportRbxm("ReplicatedStorage._StagingEffects", "Effects"))
-- writes tools/frag/Effects.rbxm. rootName renames the root in the file (a
-- staging copy exported under the real name); the instance in Studio is untouched.

local SerializationService = game:GetService("SerializationService")

local ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

local function base64(b: buffer): string
	local out = table.create(math.ceil(buffer.len(b) / 3))
	local n = buffer.len(b)
	for i = 0, n - 1, 3 do
		local a = buffer.readu8(b, i)
		local c1 = if i + 1 < n then buffer.readu8(b, i + 1) else 0
		local c2 = if i + 2 < n then buffer.readu8(b, i + 2) else 0
		local v = a * 65536 + c1 * 256 + c2
		local s = {}
		for k = 3, 0, -1 do
			local idx = bit32.band(bit32.rshift(v, k * 6), 63) + 1
			table.insert(s, ALPHABET:sub(idx, idx))
		end
		if i + 1 >= n then
			s[3], s[4] = "=", "="
		elseif i + 2 >= n then
			s[4] = "="
		end
		table.insert(out, table.concat(s))
	end
	return table.concat(out)
end

_G.exportRbxm = function(target: string, rootName: string?): string
	local node = game
	for part in string.gmatch(target, "[^%.]+") do
		node = node:FindFirstChild(part) or game:GetService(part)
	end
	local root = node
	if rootName and rootName ~= node.Name then
		root = node:Clone()
		root.Name = rootName
	end
	local ok, result = pcall(SerializationService.SerializeInstancesAsync, SerializationService, { root })
	if root ~= node then
		root:Destroy()
	end
	assert(ok, result)
	return base64(result)
end
return "exportRbxm installed"
	end)
	table.insert(installed, "export_rbxm.luau: " .. tostring(msg))
end
do -- vfx_library.luau
	local ok, msg = pcall(function()
--!nocheck
-- Searches the VFX plugin's (vfxia) Asset Library from the Studio MCP, by typing
-- into the library window's own search box and reading the tiles it shows. The
-- user must have opened the Asset Library window once this Studio session, in
-- Edit mode (it lives in CoreGui.RobloxGui.Selection.Seperate.Library; closing
-- it only hides it). Run this file once through
-- execute_luau: it installs
--   _G.vfxLibrary.search(query, limit?) -> { { id, kind, name? } }
--   _G.vfxLibrary.index(queries, limit?) -> JSON { [query] = { ... } }
-- kind is "image", "mesh", "flipbook" or "sound" (sounds also carry a name).
-- Tiles only carry the asset id; to judge an image, fetch its thumbnail:
-- https://thumbnails.roblox.com/v1/assets?assetIds=<id>&size=150x150&format=Png
-- tools/vfx_library.json is a keyword index built with index().

local HttpService = game:GetService("HttpService")

local function library()
	local node = game:GetService("CoreGui"):FindFirstChild("RobloxGui")
	for _, name in { "Selection", "Seperate", "Library" } do
		node = node and node:FindFirstChild(name)
	end
	-- search keeps working after the window is closed, as long as it was opened once
	assert(node, "Open the VFX plugin's Asset Library window in Edit mode first")
	return node.Top.Search.Box, node.Folder.Right.Scroll
end

local function tiles(query: string)
	local box, scroll = library()
	box.Text = query
	task.wait(0.6)
	local found = {}
	for _, tile in scroll:GetChildren() do
		if tile:IsA("GuiButton") and tile.Visible and tile.Name:match("^%d+$") then
			table.insert(found, tile)
		end
	end
	table.sort(found, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	return found
end

-- Flipbooks look like images in the grid; the library tags them "flipbook".
local flipbooks
local function isFlipbook(id: string): boolean
	if not flipbooks then
		flipbooks = {}
		for _, tile in tiles("flipbook") do
			flipbooks[tile.Name] = true
		end
	end
	return flipbooks[id] == true
end

local function describe(tile)
	if tile:FindFirstChildWhichIsA("ViewportFrame") then
		return { id = tile.Name, kind = "mesh" }
	end
	local label = tile:FindFirstChildWhichIsA("TextLabel")
	if label then
		return { id = tile.Name, kind = "sound", name = label.Text }
	end
	return { id = tile.Name, kind = if isFlipbook(tile.Name) then "flipbook" else "image" }
end

local function search(query: string, limit: number?)
	isFlipbook("") -- run the flipbook search first so it doesn't replace this query
	local results = {}
	for _, tile in tiles(query) do
		if limit and #results >= limit then
			break
		end
		table.insert(results, describe(tile))
	end
	return results
end

_G.vfxLibrary = {
	search = search,
	index = function(queries, limit)
		local out = {}
		for _, q in queries do
			out[q] = search(q, limit)
		end
		library().Text = ""
		return HttpService:JSONEncode(out)
	end,
}
return "vfxLibrary installed"
	end)
	table.insert(installed, "vfx_library.luau: " .. tostring(msg))
end
do -- anim_markers.luau
	local ok, msg = pcall(function()
--!nocheck
-- Reads an animation's length and markers (animation events) in Studio, for
-- syncing effects to them. Run this file once through the Studio MCP's
-- execute_luau: it installs _G.animMarkers(animation) where `animation` is an
-- Animation instance, its path ("ReplicatedStorage.Animations.Fists.1") or an
-- "rbxassetid://..." id. Returns { id, kind, length, markers = { { name, time, value } } }
-- sorted by time. KeyframeSequenceProvider returns empty sequences for these
-- assets, so it loads the asset itself with game:GetObjects. Handles both
-- KeyframeSequence markers and CurveAnimation MarkerCurves.

local function resolve(animation)
	if typeof(animation) == "Instance" then
		return animation.AnimationId
	end
	if animation:match("^rbxassetid://") or animation:match("^%d+$") then
		return if animation:match("^%d+$") then "rbxassetid://" .. animation else animation
	end
	local node = game
	for part in string.gmatch(animation, "[^%.]+") do
		node = node:FindFirstChild(part) or game:GetService(part)
	end
	return node.AnimationId
end

_G.animMarkers = function(animation)
	local id = resolve(animation)
	assert(id ~= "", "animation has no AnimationId")
	local asset = game:GetObjects(id)[1]
	assert(asset, "couldn't load " .. id)
	local markers, length = {}, 0
	for _, d in asset:GetDescendants() do
		if d:IsA("Keyframe") then
			length = math.max(length, d.Time)
			for _, m in d:GetMarkers() do
				table.insert(markers, { name = m.Name, time = d.Time, value = m.Value })
			end
		elseif d:IsA("MarkerCurve") then
			for _, m in d:GetMarkers() do
				table.insert(markers, { name = d.Name, time = m.Time, value = m.Value })
				length = math.max(length, m.Time)
			end
		end
	end
	if asset:IsA("CurveAnimation") then
		for _, d in asset:GetDescendants() do
			if d:IsA("FloatCurve") then
				for _, k in d:GetKeys() do
					length = math.max(length, k.Time)
				end
			end
		end
	end
	table.sort(markers, function(a, b)
		return a.time < b.time
	end)
	asset:Destroy()
	return { id = id, kind = asset.ClassName, length = length, markers = markers }
end
return "animMarkers installed"
	end)
	table.insert(installed, "anim_markers.luau: " .. tostring(msg))
end
do -- vfx_preview.luau
	local ok, msg = pcall(function()
--!nocheck
-- Edit-mode preview kit for effect templates. Run this file once through the
-- Studio MCP's execute_luau; it installs _G.vfxPreview:
--
--   P.scene({ center?, enemies? = {"SpiritWolf", ...}, offsets? = {Vector3...},
--             radius? })            -> scene table { C, rig, enemies, folder }
--       A clean grass floor in open sky (no props in the way), a caster stand-in
--       (a clone of workspace.Rig, facing +X), enemy clones from
--       ServerStorage.Enemies facing the caster, and red posts at `radius` to
--       check a gameplay shape against.
--   P.emit(inst)       native ParticleEmitter:Emit honouring EmitCount/EmitDelay
--       (shared.fx.emit works too, but in Edit mode it starts ~0.1 s late, so
--       frozen-frame captures drift; use this for timing, fx.emit to confirm
--       the module plays everything).
--   P.freeze(seconds)  wait, then TimeScale = 0 on every emitter in the scene
--       so a screen_capture shows that exact moment. Tweens keep running.
--   P.clone(path)      clone a template (e.g. "Effects.PalmStrike.PalmStrike_T4"
--       under ReplicatedStorage) into the scene.
--   P.clear(keepScene?) remove clones (and the scene unless keepScene), the
--       fresh module copies, and empty workspace.Terrain.TempVFX.
--   P.fresh(names)     fresh copies of client modules (StarterPlayerScripts.Client)
--       plus a mirror of ReplicatedStorage.Shared in ServerStorage._PreviewModules,
--       with `ReplicatedStorage.Shared` requires pointed at the mirror. Edit's
--       require cache can hold stale versions of modules required earlier in the
--       session (Config without Combat, say), so never require the live ones.
--       The copy of TechniqueVFX gets: folder = the scene's _fxOut folder
--       (screen_capture swaps the camera, and a Camera's children only render
--       while it is current), cleanup disabled (frozen frames must survive until
--       captured), and CameraShake/ImpactFrames attributes stripped before emit
--       (ScreenEffects moves the editor camera and spoils the capture).
--   P.castThrough({ id, level, freezeAt?, animation? }) -> summary string
--       The real call path: plays the technique's Fists animation on the scene
--       rig at the cast's playback speed (Rules.castProfile), calls
--       CombatEffects.windup at start and CombatEffects.cast at Hit with the rig's
--       live root and hands, then freezes particles at `freezeAt` seconds after
--       cast start. Pass a level (1, 4, 7, 10 for tiers I-IV), not a tier.
-- Typical camera for screen_capture: behind-right of the caster at player
-- distance, e.g. C + (-12, 9, 5) looking at C + (4, 1, 0); top-down
-- C + (0.1, 28, 0) -> C checks radii against the posts.

local RS = game:GetService("ReplicatedStorage")
local RIG_GROUP = "_VFXPreviewRig" -- unregistered again by P.clear
local P = {}
local S = nil

local function sampled(v)
	if typeof(v) == "NumberRange" then
		return v.Min + math.random() * (v.Max - v.Min)
	end
	return if type(v) == "number" then v else 0
end
local function inherited(inst, root, name)
	local at = inst
	while at do
		local v = at:GetAttribute(name)
		if v ~= nil then
			return v
		end
		if at == root then
			break
		end
		at = at.Parent
	end
end
local function delayOf(inst, root)
	local s, at = 0, inst
	while at do
		s += sampled(at:GetAttribute("EmitDelay"))
		if at == root then
			break
		end
		at = at.Parent
	end
	return s
end

function P.emit(root)
	local list = root:GetDescendants()
	table.insert(list, root)
	for _, d in list do
		if d:IsA("ParticleEmitter") then
			local dl = delayOf(d, root)
			local n = math.max(1, math.round(sampled(inherited(d, root, "EmitCount") or 1)))
			if dl > 0 then
				task.delay(dl, function()
					d:Emit(n)
				end)
			else
				d:Emit(n)
			end
		end
	end
end

function P.freeze(seconds)
	task.wait(seconds)
	for _, root in { S and S.folder, workspace.Terrain:FindFirstChild("TempVFX") } do
		if root then
			for _, d in root:GetDescendants() do
				if d:IsA("ParticleEmitter") then
					d.TimeScale = 0
				end
			end
		end
	end
end

local function ground(p)
	local hit = workspace:Raycast(p + Vector3.new(0, 10, 0), Vector3.new(0, -40, 0))
	return if hit then hit.Position.Y else p.Y
end

function P.scene(opts)
	opts = opts or {}
	P.clear()
	local C = opts.center or Vector3.new(400, 640, 300)
	local folder = Instance.new("Folder")
	folder.Name = "_VFXPreview"
	folder.Parent = workspace
	local floor = Instance.new("Part")
	floor.Name = "Floor"
	floor.Anchored = true
	floor.Size = Vector3.new(90, 2, 90)
	floor.CFrame = CFrame.new(C - Vector3.new(0, 1, 0))
	floor.Material = Enum.Material.SmoothPlastic -- textured grass muddies reads
	floor.Color = Color3.fromRGB(98, 170, 60)
	floor.Parent = folder
	local rig = workspace:FindFirstChild("Rig")
	rig = rig and rig:Clone()
	if rig then
		local _, size = rig:GetBoundingBox()
		rig:PivotTo(CFrame.lookAt(C + Vector3.new(0, size.Y / 2, 0), C + Vector3.new(1, size.Y / 2, 0)))
		-- the game's ground rays skip player characters; Edit has none, so put the
		-- stand-in in a collision group that ignores Default (default raycasts then
		-- skip it). CanCollide/CanQuery don't work: an R6 Humanoid forces Torso
		-- and Head CanCollide back on, and CanQuery is ignored while CanCollide.
		local PhysicsService = game:GetService("PhysicsService")
		if not PhysicsService:IsCollisionGroupRegistered(RIG_GROUP) then
			PhysicsService:RegisterCollisionGroup(RIG_GROUP)
		end
		PhysicsService:CollisionGroupSetCollidable(RIG_GROUP, "Default", false)
		for _, d in rig:GetDescendants() do
			if d:IsA("BasePart") then
				d.CollisionGroup = RIG_GROUP
			end
		end
		rig.Parent = folder
	end
	local out = Instance.new("Folder")
	out.Name = "_fxOut"
	out.Parent = folder
	local enemies = {}
	local names = opts.enemies or { "SpiritWolf", "StoneBoar" }
	local offsets = opts.offsets or { Vector3.new(5.5, 0, 2.5), Vector3.new(8, 0, -3.5), Vector3.new(14, 0, 1), Vector3.new(20, 0, -2) }
	for i, name in names do
		local source = game.ServerStorage.Enemies:FindFirstChild(name)
		if source then
			local e = source:Clone()
			for _, d in e:GetDescendants() do
				if d:IsA("BaseScript") then
					d:Destroy()
				end
			end
			local _, es = e:GetBoundingBox()
			local p = C + offsets[i]
			e:PivotTo(CFrame.lookAt(Vector3.new(p.X, ground(p) + es.Y / 2, p.Z), Vector3.new(C.X, ground(p) + es.Y / 2, C.Z)))
			e:AddTag("Enemy") -- Hitbox.enemiesIn and the ground filter look for it
			e.Parent = folder
			table.insert(enemies, e)
		end
	end
	if opts.radius then
		for i = 0, 7 do
			local a = i / 8 * math.pi * 2
			local post = Instance.new("Part")
			post.Name = "RadiusPost"
			post.Anchored, post.CanCollide, post.CanQuery, post.CanTouch = true, false, false, false
			post.Size = Vector3.new(0.25, 1.2, 0.25)
			post.Color = Color3.new(1, 0.1, 0.1)
			post.CFrame = CFrame.new(C + Vector3.new(math.cos(a) * opts.radius, 0.6, math.sin(a) * opts.radius))
			post.Parent = folder
		end
	end
	S = { C = C, rig = rig, enemies = enemies, folder = folder }
	P.current = S
	return S
end

function P.clone(path)
	local node = RS
	for part in string.gmatch(path, "[^%.]+") do
		node = node[part]
	end
	local copy = node:Clone()
	copy.Name = "_fx" .. copy.Name
	copy.Parent = S.folder
	return copy
end

function P.clear(keepScene)
	if S and S.folder.Parent then
		if keepScene then
			for _, d in S.folder:GetChildren() do
				if d.Name:match("^_fx") then
					d:Destroy()
				end
			end
		else
			S.folder:Destroy()
			S = nil
		end
	end
	local old = workspace:FindFirstChild("_VFXPreview")
	if old and not keepScene then
		old:Destroy()
	end
	local temp = workspace.Terrain:FindFirstChild("TempVFX")
	if temp then
		temp:ClearAllChildren()
	end
	local mods = game.ServerStorage:FindFirstChild("_PreviewModules")
	if mods and not keepScene then
		mods:Destroy()
	end
	if not keepScene then
		local PhysicsService = game:GetService("PhysicsService")
		if PhysicsService:IsCollisionGroupRegistered(RIG_GROUP) then
			PhysicsService:UnregisterCollisionGroup(RIG_GROUP)
		end
	end
	pcall(function()
		game:GetService("RunService"):UnbindFromRenderStep("CombatShake")
	end)
end

function P.fresh(names)
	local holder = game.ServerStorage:FindFirstChild("_PreviewModules")
	if holder then
		holder:Destroy()
	end
	holder = Instance.new("Folder")
	holder.Name = "_PreviewModules"
	holder.Parent = game.ServerStorage
	RS.Shared:Clone().Parent = holder
	local client = game.StarterPlayer.StarterPlayerScripts.Client
	for _, n in names do
		local m = client[n]:Clone()
		m.Source = m.Source:gsub("ReplicatedStorage%.Shared", 'game:GetService("ServerStorage")._PreviewModules.Shared')
		m.Parent = holder
	end
	local tvModule = holder:FindFirstChild("TechniqueVFX")
	if tvModule and S then
		local TV = require(tvModule)
		TV.folder = S.folder._fxOut
		TV.cleanup = function() end
		local emit = TV.emit
		TV.emit = function(inst)
			for _, d in inst:GetDescendants() do
				d:SetAttribute("CameraShake", nil)
				d:SetAttribute("ImpactFrames", nil)
			end
			emit(inst)
		end
	end
	return holder
end

function P.castThrough(opts)
	assert(S, "call P.scene first")
	local RunService = game:GetService("RunService")
	S.folder._fxOut:ClearAllChildren()
	local temp = workspace.Terrain:FindFirstChild("TempVFX")
	if temp then
		temp:ClearAllChildren()
	end
	local holder = P.fresh({ "CombatEffects", "Sfx", "TechniqueVFX" })
	local CE = require(holder.CombatEffects)
	local Techniques = require(holder.Shared.Techniques)
	local Rules = require(holder.Shared.ActionRules)
	local def = Techniques.Defs[opts.id]
	local profile = Rules.castProfile(def)
	local rig, root = S.rig, S.rig.HumanoidRootPart
	root.Anchored = true
	local hum = rig:FindFirstChildOfClass("Humanoid")
	local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)
	local track = animator:LoadAnimation(opts.animation or RS.Animations.Fists[tostring(def.animation)])
	local t0 = os.clock()
	while track.Length == 0 and os.clock() - t0 < 5 do
		task.wait()
	end
	track:Play(0, 1, 0)
	local dir = (root.CFrame.LookVector * Vector3.new(1, 0, 1)).Unit
	local start, cast, err = os.clock(), false, nil
	local ok, e = pcall(CE.windup, rig, opts.id, opts.level)
	if not ok then
		err = e
	end
	while true do
		local t = os.clock() - start
		track.TimePosition = math.min(t * profile.speed, track.Length - 0.01)
		animator:StepAnimations(0)
		if not cast and t >= profile.windup then
			cast = true
			local ok2, e2 = pcall(CE.cast, rig, opts.id, root.Position, dir, nil, opts.level)
			if not ok2 then
				err = e2
			end
		end
		if (opts.freezeAt and t >= opts.freezeAt) or t > 3 then
			break
		end
		RunService.Heartbeat:Wait()
	end
	if opts.freezeAt then
		for _, r in { workspace.Terrain:FindFirstChild("TempVFX"), S.folder } do
			if r then
				for _, d in r:GetDescendants() do
					if d:IsA("ParticleEmitter") then
						d.TimeScale = 0
					end
				end
			end
		end
	end
	pcall(function()
		RunService:UnbindFromRenderStep("CombatShake")
	end)
	local kids = {}
	for _, d in S.folder._fxOut:GetChildren() do
		table.insert(kids, d.Name)
	end
	return string.format("t=%.2f err=%s spawned=%s", os.clock() - start, tostring(err), table.concat(kids, ","))
end

_G.vfxPreview = P
return "vfxPreview installed"
	end)
	table.insert(installed, "vfx_preview.luau: " .. tostring(msg))
end
do -- vfx_stage.luau
	local ok, msg = pcall(function()
--!nocheck
-- One-call staging for the mapped ReplicatedStorage.Effects folder. Run this file
-- (and tools/export_rbxm.luau, for _G.exportRbxm) once through execute_luau,
-- with tools/receive_rbxmx.py running. Installs _G.vfxStage:
--
--   local staging = _G.vfxStage.begin()   -- fresh clone at ReplicatedStorage._StagingEffects
--   ... edit/build inside `staging` ...
--   _G.vfxStage.finish()                  -- export, destroy staging, wait for Rojo
--
-- finish() POSTs the staging copy as Effects.rbxm (root renamed to "Effects"),
-- destroys the staging copy, and returns a summary: templates per group, tagged
-- add-on instances, and how many Effects copies exist. Then on disk run
-- tools/vfx_export.sh to move the file into assets/ and verify it; Rojo patches
-- the live folder from the file (finish's `wait` polls `check` for that).
--
-- Never build in ReplicatedStorage.Effects itself (AGENTS.md, "Studio instances").

local RS = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local CollectionService = game:GetService("CollectionService")

local Stage = {}
local NAME = "_StagingEffects"

function Stage.begin()
	local old = RS:FindFirstChild(NAME)
	if old then
		old:Destroy()
	end
	local staging = RS.Effects:Clone()
	staging.Name = NAME
	staging.Parent = RS
	return staging
end

local function summary(root)
	local groups = {}
	for _, group in root:GetChildren() do
		local names = {}
		for _, t in group:GetChildren() do
			table.insert(names, t.Name)
		end
		table.sort(names)
		table.insert(groups, group.Name .. "[" .. table.concat(names, ",") .. "]")
	end
	local tags = {}
	for _, tag in { "CraterVFX", "SplineVFX", "MeshVFX", "ColorVFX", "ScaleVFX" } do
		local n = 0
		for _, inst in CollectionService:GetTagged(tag) do
			if inst:IsDescendantOf(root) then
				n += 1
			end
		end
		if n > 0 then
			table.insert(tags, tag .. "=" .. n)
		end
	end
	return table.concat(groups, " ") .. " | tags " .. table.concat(tags, ",")
end

-- check(): optional function(effectsFolder) -> boolean, true once Rojo has
-- applied the change (e.g. an attribute you just set). Waits up to 10 s.
function Stage.finish(check)
	assert(_G.exportRbxm, "run tools/export_rbxm.luau first")
	local staging = RS:FindFirstChild(NAME)
	assert(staging, "no staging copy; call begin() first")
	local text = summary(staging)
	local reply = HttpService:PostAsync("http://127.0.0.1:8766/Effects.rbxm", _G.exportRbxm("ReplicatedStorage." .. NAME, "Effects"))
	staging:Destroy()
	local synced = check == nil
	if check then
		local t0 = os.clock()
		while os.clock() - t0 < 10 do
			if pcall(check, RS.Effects) and check(RS.Effects) then
				synced = true
				break
			end
