		Size = NS({ KP(0, 0.8), KP(0.25, 2.4 + tier * 0.5), KP(1, 2.8 + tier * 0.6) }), Transparency = NS({ KP(0, 0), KP(0.5, 0.35), KP(1, 1) }),
		Lifetime = R(0.4), Rotation = R(0, 360), ZOffset = 0.3,
	}), { EmitCount = 1 })
