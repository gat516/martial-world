local R6_GRIP_C0 = CFrame.new(0, -1, 0) * CFrame.Angles(-math.pi / 2, 0, 0)
local R6_GRIP_ROT = CFrame.Angles(-math.pi / 2, 0, 0)
local BACK_C0 = CFrame.new(0, 0.2, 0) * CFrame.Angles(0, 0, -BACK_TILT) -- zither, from BodyBackAttachment

local function partStyle(name)
	local o = OVERRIDES[name] or {}
	local colour = o.colour
	if not colour then
		for _, pair in COLOUR_BY_SUFFIX do
			if string.sub(name, -#pair[1]) == pair[1] then
				colour = pair[2]
				break
			end
		end
	end
	assert(colour, "no colour rule for mesh " .. name)
	return PALETTE[colour], o.material or Enum.Material.SmoothPlastic, o.transparency or 0
end

local function meshName(part)
	return part:GetAttribute("MeshName") or part.Name
end

local function importRoot(part)
	local node = part
	while node.Parent and node.Parent ~= workspace do
		node = node.Parent
	end
	return node
end

local function anchorFrame(a)
	return CFrame.new(a[1], a[2], a[3]) * CFrame.Angles(0, math.rad(a.roll or 0), 0)
end

-- A source mesh: its asset id and native size, from an imported MeshPart or from a template's
-- Part + SpecialMesh. (Rojo can't write MeshPart.MeshId when it syncs, so the templates use
-- Parts with a FileMesh SpecialMesh, which it can.)
local function meshSource(d)
	if d:IsA("MeshPart") then
		if d.MeshId ~= "" and d.MeshSize.Magnitude > 1e-4 then
			return { id = d.MeshId, native = d.MeshSize }
		end
	elseif d:IsA("BasePart") then
		local sm = d:FindFirstChildOfClass("SpecialMesh")
		if sm and sm.MeshType == Enum.MeshType.FileMesh and sm.MeshId ~= "" then
			return { id = sm.MeshId, native = d.Size / sm.Scale }
		end
	end
	return nil
end

-- every mesh the items need: a fresh import in Workspace wins, else the existing templates
local function collectSources()
	local sources, importRoots = {}, {}
	local function scan(root, fromImport)
		for _, d in root:GetDescendants() do
			local src = d:IsA("BasePart") and not d:FindFirstAncestor("WeaponShowcase") and meshSource(d)
			if src and (d:IsA("MeshPart") or not fromImport) then
				local name = meshName(d)
				for _, item in ITEMS do
					if item.meshes[name] then
						if fromImport then
							assert(not sources[name] or not sources[name].fromImport,
								"mesh imported more than once: " .. name .. " (delete the extra import)")
							importRoots[importRoot(d)] = true
						end
						if fromImport or not sources[name] then
							src.fromImport = fromImport
							sources[name] = src
						end
					end
				end
			end
		end
	end
	for _, name in { STAGING, "WeaponModels" } do
		local old = ServerStorage:FindFirstChild(name)
		if old then
			scan(old, false)
		end
	end
	scan(workspace, true)
	for _, item in ITEMS do
		for name in item.meshes do
			assert(sources[name], "mesh missing: " .. name .. " (File > Import 3D art/fbx_export/*.fbx first)")
		end
	end
	return sources, importRoots
end

-- the item's meshes, styled, in item space (or `toSpace` * item space): a Part sized from the
-- bounds JSON with a FileMesh SpecialMesh scaled to fill it
local function makeParts(item, sources, container, toSpace)
	local parts = {}
	for name, m in item.meshes do
		local src = sources[name]
		local part = Instance.new("Part")
		part.Name = name
		local c, s = m.center, m.size
		part.Size = Vector3.new(s[1], s[3], s[2])
		part.CFrame = toSpace * CFrame.Angles(0, math.pi, 0) * CFrame.new(-c[1], c[3], c[2])
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.FileMesh
		mesh.MeshId = src.id
		mesh.Scale = part.Size / src.native
		mesh.Parent = part
		local colour, material, transparency = partStyle(name)
		part.Color, part.Material, part.Transparency = colour, material, transparency
		part.TopSurface, part.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
		part.Anchored = false
		part.CanCollide, part.CanQuery, part.CanTouch = false, false, false
		part.Massless = true
		part.CastShadow = name ~= "SpiritStoneCore"
		part.Parent = container
		parts[name] = part
		if name == "SpiritStoneCore" then
			local light = Instance.new("PointLight")
			light.Color = PALETTE.core
			light.Brightness = 1.6
			light.Range = 8
			light.Shadows = false
			light.Parent = part
		end
	end
	return parts
end

local function weldAll(main, parts)
	for _, part in parts do
		if part ~= main then
			local weld = Instance.new("WeldConstraint")
			weld.Part0, weld.Part1 = main, part
			weld.Parent = part
		end
	end
end

local function addAttachment(parent, name, cf)
	local att = Instance.new("Attachment")
	att.Name = name
	att.CFrame = cf
	att.Parent = parent
	return att
end

-- class weapon: Model, PrimaryPart = the joint part, Motor6D inside it, meshes welded to it
local function buildWeapon(itemName, item, sources, folder)
	local w = WEAPONS[itemName]
	local j = w.j
	local model = Instance.new("Model")
	model.Name = itemName
	model:SetAttribute("Joint", j.joint)

	local hilt = Instance.new("Part")
	hilt.Name = j.joint
	hilt.Size = Vector3.new(0.2, 0.2, 0.2)
	hilt.Transparency = 1
	hilt.CFrame = CFrame.identity
	hilt.Anchored = false
	hilt.Massless = true
	hilt.CanCollide, hilt.CanQuery, hilt.CanTouch = false, false, false
	hilt.CastShadow = false
	hilt.Parent = model

	local motor = Instance.new("Motor6D")
	motor.Name = j.joint
	motor.Part0 = nil
	motor.Part1 = hilt
	motor.C0 = j.c0
	motor.C1 = j.c1
	motor.Parent = hilt

	-- joint part in arm space, and the item in arm space (grip anchor on the hand, Roblox's
	-- tool-hold rotation, the anchor's roll turning the edge): their difference places the item
	local hiltInArm = j.c0 * j.c1:Inverse()
	local itemInArm = CFrame.new(j.hand) * R6_GRIP_ROT * anchorFrame(item.anchors.grip):Inverse()
	local itemInHilt = hiltInArm:Inverse() * itemInArm

	local parts = makeParts(item, sources, model, itemInHilt)
	weldAll(hilt, parts)

	local function point(spec)
		local a = if type(spec) == "string" then item.anchors[spec] else spec
		assert(a, itemName .. ": no anchor " .. tostring(spec))
		return itemInHilt * CFrame.new(a[1], a[2], a[3])
	end
	addAttachment(hilt, "Tip", point(w.tip))
	addAttachment(hilt, "Base", point(w.base))
	for anchorName, a in item.anchors do
		addAttachment(hilt, anchorName, itemInHilt * anchorFrame(a))
	end
	model.PrimaryPart = hilt
	model.Parent = folder
	return model
end

-- Dizi (Tool), Zither (Accessory), SpiritStone (Model), ManualScroll (anchored prop Model)
local function buildOther(itemName, item, sources, folder)
	local kind, mainName = KIND[itemName][1], KIND[itemName][2]
	local container = Instance.new(if kind == "Prop" then "Model" else kind)
	container.Name = itemName
	local parts = makeParts(item, sources, container, CFrame.identity)
	local main = parts[mainName]
	assert(main, itemName .. ": main mesh " .. mainName .. " missing")
	if kind == "Prop" then
		for _, part in parts do
			part.Anchored = true
		end
	else
		weldAll(main, parts)
	end
	local toMain = main.CFrame:Inverse()
	for anchorName, a in item.anchors do
		addAttachment(main, anchorName, toMain * anchorFrame(a))
	end
	if kind == "Tool" then
		main.Name = "Handle"
		main:SetAttribute("MeshName", mainName)
		main.CanTouch = true -- Tool handles touch to be picked up
		container.RequiresHandle = true
		container.CanBeDropped = false
		container.Grip = main.grip.CFrame -- RightGrip C1: the grip anchor lands on the hand frame
	elseif kind == "Accessory" then
		main.Name = "Handle"
		main:SetAttribute("MeshName", mainName)
		container.AccessoryType = Enum.AccessoryType.Back
		-- the accessory weld puts this attachment on the Torso's BodyBackAttachment: zither
		-- underside (item -Z) against the back, strings out, head leaning over the right shoulder
		addAttachment(main, "BodyBackAttachment", main.back_carry.CFrame * BACK_C0:Inverse())
	else
		container.PrimaryPart = main
		main.PivotOffset = main.CFrame:Inverse() -- pivot = item origin (the scroll: its footprint)
	end
	container.Parent = folder
	return container
end

-- KeyframeSequence sampling (fetched before the recording starts: it yields)
local function loadTracks(id)
	-- a fresh copy: KeyframeSequenceProvider hands out one cached instance per id, so destroying
	-- it (or anyone else having done so) leaves later calls empty for the rest of the session
	local ks = game:GetObjects("rbxassetid://" .. id)[1]
	assert(ks and ks:IsA("KeyframeSequence"), "animation " .. id .. " is not a KeyframeSequence")
	local tracks = {}
	for _, kf in ks:GetKeyframes() do
		for _, pose in kf:GetDescendants() do
			if pose:IsA("Pose") and pose.Weight > 0 then
				tracks[pose.Name] = tracks[pose.Name] or {}
				table.insert(tracks[pose.Name], { kf.Time, pose.CFrame })
			end
		end
	end
	for _, list in tracks do
		table.sort(list, function(a, b)
			return a[1] < b[1]
		end)
	end
	ks:Destroy()
	return tracks
end

local function sample(tracks, name, t)
	local list = tracks[name]
	if not list then
		return CFrame.identity
	end
	if t <= list[1][1] then
		return list[1][2]
	end
	for i = 2, #list do
		if list[i][1] >= t then
			local a, b = list[i - 1], list[i]
			return a[2]:Lerp(b[2], (t - a[1]) / math.max(b[1] - a[1], 1e-6))
		end
	end
	return list[#list][2]
end

-- bake a pose into the rig's joints (Edit mode has no Animator stepping): C0 = C0 * Transform
local function pose(rig, tracks, t)
	for _, m in rig:GetDescendants() do
		if m:IsA("Motor6D") and m.Part1 then
			m.C0 = m.C0 * sample(tracks, m.Part1.Name, t)
		end
	end
end

local function newRig(name, cf, parent)
	local rig = workspace.Rig:Clone()
	rig.Name = name
	for _, d in rig:GetChildren() do
		if d:IsA("Script") or d:IsA("LocalScript") or d.Name == "AnimSaves" then
			d:Destroy() -- the source rig's Animate script and saved animations stay on the original only
		end
	end
	rig:PivotTo(cf)
	rig.HumanoidRootPart.Anchored = true
	rig.Parent = parent
	return rig
end

local function hold(rig, weapon)
	weapon.Parent = rig
	weapon.PrimaryPart:FindFirstChildOfClass("Motor6D").Part0 = rig["Right Arm"]
end

local function equipTool(rig, tool)
	local shoulder = rig.Torso["Right Shoulder"]
	shoulder.C0 = shoulder.C0 * CFrame.Angles(0, 0, ARM_RAISE)
	tool.Parent = rig
	local weld = Instance.new("Weld")
	weld.Name = "RightGrip"
	weld.Part0 = rig["Right Arm"]
	weld.Part1 = tool.Handle
	weld.C0 = R6_GRIP_C0
	weld.C1 = tool.Grip
	weld.Parent = rig["Right Arm"]
end

local function wear(rig, accessory)
	accessory.Parent = rig
	local handle = accessory.Handle
	local weld = Instance.new("Weld")
	weld.Name = "AccessoryWeld"
	weld.Part0 = handle
	weld.Part1 = rig.Torso
	weld.C0 = handle.BodyBackAttachment.CFrame
	weld.C1 = rig.Torso.BodyBackAttachment.CFrame
	weld.Parent = handle
end

assert(workspace:FindFirstChild("Rig") and workspace.Rig:FindFirstChild("Humanoid"), "Workspace.Rig (R6) missing")
local clips = {}
for _, w in WEAPONS do
	for _, id in { w.idle, w.m1 } do
		clips[id] = clips[id] or loadTracks(id)
	end
end

local recording = ChangeHistoryService:TryBeginRecording("PlaceWeapons")
local ok, err = pcall(function()
	local sources, importRoots = collectSources()

	local old = ServerStorage:FindFirstChild(STAGING)
	if old then
		old:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = STAGING
	for itemName, item in ITEMS do
		if WEAPONS[itemName] then
			buildWeapon(itemName, item, sources, folder)
		else
			buildOther(itemName, item, sources, folder)
		end
	end
	folder.Parent = ServerStorage

	local show = workspace:FindFirstChild("WeaponShowcase")
	if not show then
		show = Instance.new("Folder")
		show.Name = "WeaponShowcase"
		show.Parent = workspace
	end
	for _, child in show:GetChildren() do
		local n = child.Name
		if string.sub(n, 1, 9) == "Showcase_" or string.sub(n, 1, 6) == "Posed_" or n == "SpiritStone"
			or n == "ManualScroll" then
			child:Destroy()
		end
	end
	for i, itemName in ORDER do
		local x = ROW_X0 + (i - 1) * ROW_DX
		local cf = CFrame.new(x, FLOOR_Y + 3, ROW_Z) * CFrame.Angles(0, math.pi, 0) -- face +Z
		local rig = newRig("Showcase_" .. itemName, cf, show)
		local w = WEAPONS[itemName]
		local item = folder[itemName]:Clone()
		if w then
			hold(rig, item)
			pose(rig, clips[w.idle], 0)
			local posed = newRig("Posed_" .. itemName, cf + Vector3.new(0, 0, POSED_DZ), show)
			hold(posed, folder[itemName]:Clone())
			pose(posed, clips[w.m1], w.hit)
		elseif item:IsA("Tool") then
			equipTool(rig, item)
		else
			wear(rig, item)
		end
		if itemName == "Jian" then
			local stone = folder.SpiritStone:Clone()
			for _, p in stone:GetDescendants() do
				if p:IsA("BasePart") then
					p.Anchored = true
				end
			end
			stone:PivotTo(cf * CFrame.new(-2.6, -0.3, 0)) -- floating beside the rig's left hand
			stone.Parent = show
			local scroll = folder.ManualScroll:Clone()
			scroll:PivotTo(CFrame.new(x - 3, FLOOR_Y, ROW_Z + 2.5))
			scroll.Parent = show
		end
	end

	for root in importRoots do
		if root.Parent == workspace then
			root:Destroy()
		end
	end
end)
if recording then
	ChangeHistoryService:FinishRecording(recording, ok and Enum.FinishRecordingOperation.Commit or Enum.FinishRecordingOperation.Cancel)
end
assert(ok, err)
return "built " .. STAGING .. " and " .. #ORDER .. " showcase rigs"
