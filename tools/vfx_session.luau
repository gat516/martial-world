		Size = seq(0, 0, 0.12, 0.5, 0.75, 0.45, 1, 0), Transparency = seq(0, 0, 0.8, 0, 1, 1),
		Color = cseq(0, STONE, 1, UMBER), Lifetime = R(1, 1.2), Speed = R(0.3, 0.6), Rotation = R(-15, 15), LightEmission = 0,
