	-- HowlRings (howl, at the Mouth facing forward): three pale sound rings
	-- rolling out of the jaws, the first over a slate ring.
	do
		local p = anchor("HowlRings", Vector3.new(0.4, 0.4, 0.4), root)
		local ring = {
			Texture = TEX.ring,
