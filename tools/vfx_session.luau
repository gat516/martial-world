local function ring(d, fat)
	return V3(d, d * 0.0634 * (fat or 1), d)
end

-- A looping emitter (off in the template; the runtime and the plugin's T enable it).
local function loop(parent, name, props, a)
	local e = Instance.new("ParticleEmitter")
	e.Name = name
	e.Rate = 1
	e.Enabled = false
	e.LightInfluence = 0
	e.Speed = R(0)
	e.Texture = A.glowDot
	for k, v in props do
		e[k] = v
	end
	attrs(e, { EmitDuration = LOOP })
	attrs(e, a)
	e.Parent = parent
	return e
end

-- A one-shot emitter (EmitCount n).
local function burst(parent, name, n, props, a)
	local e = Instance.new("ParticleEmitter")
	e.Name = name
	e.Rate = 0
	e.Enabled = false
	e.LightInfluence = 0
	e.Speed = R(0)
	e.Texture = A.glowDot
	for k, v in props do
		e[k] = v
	end
	attrs(e, { EmitCount = n })
	attrs(e, a)
	e.Parent = parent
	return e
end

local function wave(parent, name, p)
