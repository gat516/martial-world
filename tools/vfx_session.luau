	local halo = at("Dantian", CFrame.new(0, 1.45, 0.6), "Halo", body)
	loop(halo, "IronDisc", {
		Texture = IM.glow, Size = NS(2.4), Transparency = seq(0, 1, 0.3, 0.4, 0.7, 0.4, 1, 1), Color = CS(IRON),
