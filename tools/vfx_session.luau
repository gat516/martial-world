			Color = CS(CORE),
			LightEmission = 1,
			Lifetime = R(0.3, 0.45),
			Rate = 22,
			SpreadAngle = Vector2.new(180, 180),
			Speed = R(0.5, 1.5),
			Size = NS({ KP(0, 0.15), KP(1, 0) }),
