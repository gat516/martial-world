	attrs(root, { Height = 120, RareHeight = 210, Width = 1, Rise = 0.45, Hold = 1.5, Fade = 1.1 })
	pillar(root)
	rare(root)
	glimpse(root)
	accents(root)
	root.Parent = parent
	return root
end

